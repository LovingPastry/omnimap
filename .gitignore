# =============================================================================
# OmniMap .gitignore
# =============================================================================

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
.marscode/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
.eggs/
dist/
build/
pip-wheel-metadata/

# Virtual Environments
.venv/
venv/
.env
.env.*

# Jupyter
.ipynb_checkpoints/

# Testing / Coverage / Type Checking
.pytest_cache/
.coverage
coverage.xml
.mypy_cache/
.pytype/
.ruff_cache/

# Logs / Runtime Outputs
logs/
log/
outputs/
output/
runs/
wandb/
lightning_logs/
tensorboard/
*.log

# Data / Datasets (keep structure, ignore content)
data/
datasets/
replica/
pretrained_models/

# Model Weights
weights/
checkpoints/
*.pt
*.pth
*.ckpt

# Videos / Media
videos/
*.mkv
*.mp4
*.avi

# Documents (practice reports)
practice_reports/
*.docx

# Archives (local cleanup)
archives/
!archives/README.md
!archives/**/README.md

# CUDA / CMake Build
cmake-build-*/
CMakeFiles/
CMakeCache.txt
Makefile
*.a
*.la
*.o
*.obj
*.dll
*.exe
*.so
*.dylib

# ROS Workspace Build
ros_ws/build/
ros_ws/devel/
ros_ws/logs/

# Simulation Outputs
sim/sim_outputs/

# Third-party Build Artifacts (keep source)
thirdparty/**/build/
thirdparty/**/dist/
thirdparty/**/pip-wheel-metadata/
thirdparty/**/__pycache__/

# Archives (keep tracked .zip in repo)
*.zip
